# AgentDeck API configuration.
# Copy this file to .env and replace the placeholders. Never commit .env.
ADDR=:8080

# ---------------------------------------------------------------------------
# Local Postgres (docker compose) — two roles, see docs/ARCHITECTURE.md 11.2.
# ---------------------------------------------------------------------------
# Restricted runtime role used by the API.
DATABASE_URL=postgres://agentdeck_app:CHANGE_ME@localhost:5433/agentdeck?sslmode=disable

# Owner/migration role used only during startup migrations.
# For a single-role local database, set this to the same DSN as DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://agentdeck:CHANGE_ME@localhost:5433/agentdeck?sslmode=disable

# Public origin used to build password-reset links.
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Neon (cloud) — `neon link` + `neon deploy` manage these; do not hand-edit.
# Same two-role contract, but split across pooled and unpooled endpoints:
#   DATABASE_URL              restricted role, POOLED      (runtime)
#   MIGRATION_DATABASE_URL    owner role, UNPOOLED         (migrations, DDL)
#   DATABASE_URL_UNPOOLED     owner role, UNPOOLED         (neon.ts / tooling)
#
# Neon provisions only the owner role. `agentdeck_app` is created by migration
# 0001; its password must be set once per branch (migration cannot, since it
# runs as owner and has no access to the generated secret):
#
#   neon psql production --role-name <owner> --database-name neondb
#   > ALTER ROLE agentdeck_app WITH PASSWORD '<generated>';
#
# The runtime role also needs membership so role-switching tests can SET ROLE:
#   > GRANT agentdeck_app TO <owner>;
#
# Cloud endpoints require TLS. Keep sslmode=require and never downgrade.
# ---------------------------------------------------------------------------
